 }
+
+// transcribePCM submits one clip to the batcher and decodes its JSON reply.
+func (p *ParakeetCpp) transcribePCM(ctx context.Context, pcm []float32, language string) (transcriptJSON, error) {
+	rep := make(chan batchReply, 1)
+	select {
+	case p.bat.submit <- &batchRequest{pcm: pcm, decoder: 0, language: language, reply: rep}:
+	case <-ctx.Done():
+		return transcriptJSON{}, status.Error(codes.Canceled, "transcription cancelled")
+	}
+	var res batchReply
+	select {
+	case res = <-rep:
+	case <-ctx.Done():
+		return transcriptJSON{}, status.Error(codes.Canceled, "transcription cancelled")
+	}
+	if res.err != nil {
+		return transcriptJSON{}, res.err
+	}
+	var doc transcriptJSON
+	if err := json.Unmarshal([]byte(res.json), &doc); err != nil {
+		return transcriptJSON{}, fmt.Errorf("parakeet-cpp: decode transcript json: %w", err)
+	}
+	return doc, nil
+}
+
+// transcribePCMWindowed transcribes pcm in overlapping windows one after the
+// other when asr_window_seconds is set and the clip is longer than a window,
+// and as one clip otherwise (see windowed.go).
+func (p *ParakeetCpp) transcribePCMWindowed(ctx context.Context, pcm []float32, language string) (transcriptJSON, error) {
+	spans := asrWindows(len(pcm), p.asrWindowSec*asrSampleRate, p.asrOverlapSec*asrSampleRate)
+	if len(spans) == 1 {
+		return p.transcribePCM(ctx, pcm, language)
+	}
+	docs := make([]transcriptJSON, len(spans))
+	starts := make([]float64, len(spans))
+	ends := make([]float64, len(spans))
+	for i, sp := range spans {
+		d, err := p.transcribePCM(ctx, pcm[sp.start:sp.end], language)
+		if err != nil {
+			return transcriptJSON{}, err
+		}
+		docs[i], starts[i], ends[i] = d, float64(sp.start)/asrSampleRate, float64(sp.end)/asrSampleRate
+		xlog.Debug("parakeet-cpp: window transcribed", "window", i+1, "of", len(spans), "words", len(d.Words))
+	}
+	return mergeWindowDocs(docs, starts, ends), nil
+}
