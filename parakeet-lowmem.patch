+func TestAsrWindowsShortClipIsOneWindow(t *testing.T) {
+	if got := asrWindows(100, 0, 10); len(got) != 1 || got[0] != (asrWindowSpan{0, 100}) {
+		t.Fatalf("windowing off: %v", got)
+	}
+	if got := asrWindows(100, 100, 10); len(got) != 1 {
+		t.Fatalf("clip equal to a window: %v", got)
+	}
+}
+
+func TestAsrWindowsOverlapAndCoverage(t *testing.T) {
+	got := asrWindows(1000, 300, 50)
+	if got[0].start != 0 || got[len(got)-1].end != 1000 {
+		t.Fatalf("does not cover the clip: %v", got)
+	}
+	for i := 1; i < len(got); i++ {
+		if ov := got[i-1].end - got[i].start; ov < 50 {
+			t.Fatalf("window %d overlaps the previous by %d, want at least 50: %v", i, ov, got)
+		}
+		if got[i].end-got[i].start < 100 {
+			t.Fatalf("window %d is a sliver: %v", i, got)
+		}
+	}
+}
+
+func TestAsrWindowsShortTailIsFoldedIn(t *testing.T) {
+	got := asrWindows(560, 300, 50) // second window would be 250..550, then a 10 sample tail
+	if got[len(got)-1].end != 560 {
+		t.Fatalf("tail lost: %v", got)
+	}
+	for _, w := range got {
+		if w.end-w.start < 100 {
+			t.Fatalf("sliver window: %v", got)
+		}
+	}
+}
+
+// speech builds words one per second from a to b (absolute seconds) with a
+// pause of pause seconds before the word that starts at pauseAt.
+func speech(a, b int, pauseAt int, pause float64) []transcriptWord {
+	var ws []transcriptWord
+	shift := 0.0
+	for s := a; s < b; s++ {
+		if s == pauseAt {
+			shift = pause
+		}
+		ws = append(ws, transcriptWord{W: fmt.Sprintf("w%d", s), Start: float64(s) + shift, End: float64(s) + shift + 0.5})
+	}
+	return ws
+}
+
+func relTo(ws []transcriptWord, start float64) []transcriptWord {
+	out := make([]transcriptWord, len(ws))
+	for i, w := range ws {
+		w.Start -= start
+		w.End -= start
+		out[i] = w
+	}
+	return out
+}
+
+func TestMergeWindowDocsDropsDuplicatesAndCutsAtPause(t *testing.T) {
+	// A 100 second clip in windows 0..60 and 40..100 (20 second overlap), a
+	// 0.3 second pause before word 50.
+	all := speech(0, 100, 50, 0.3)
+	var a, b []transcriptWord
+	for _, w := range all {
+		if w.Start < 60 {
+			a = append(a, w)
+		}
+		if w.End > 40 {
+			b = append(b, w)
+		}
+	}
+	docs := []transcriptJSON{{Words: relTo(a, 0), FrameSec: 0.08}, {Words: relTo(b, 40)}}
+	m := mergeWindowDocs(docs, []float64{0, 40}, []float64{60, 100})
+	if len(m.Words) != len(all) {
+		t.Fatalf("got %d words, want %d", len(m.Words), len(all))
+	}
+	for i, w := range m.Words {
+		if w.W != all[i].W {
+			t.Fatalf("word %d is %q, want %q", i, w.W, all[i].W)
+		}
+	}
+	if m.FrameSec != 0.08 {
+		t.Fatalf("frame_sec lost")
+	}
+}
+
+func TestChooseCutPrefersTheLongestPauseInsideTheMargins(t *testing.T) {
+	ws := []transcriptWord{
+		{W: "a", Start: 40.1, End: 40.5}, // gap before it is outside the margin
+		{W: "b", Start: 46.0, End: 46.4},
+		{W: "c", Start: 46.6, End: 47.0}, // 0.2 pause
+		{W: "d", Start: 48.0, End: 48.4}, // 1.0 pause: the longest
+		{W: "e", Start: 48.5, End: 48.9},
+	}
+	got := chooseCut(ws, 40, 60)
+	if want := (47.0 + 48.0) / 2; got != want {
+		t.Fatalf("cut %v, want %v", got, want)
+	}
+	if got := chooseCut(nil, 40, 60); got != 50 {
+		t.Fatalf("no words: cut %v, want the middle, 50", got)
+	}
+}
