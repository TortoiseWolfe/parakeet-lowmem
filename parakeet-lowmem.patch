diff --git a/backend/go/parakeet-cpp/diarize_stream.go b/backend/go/parakeet-cpp/diarize_stream.go
new file mode 100644
index 0000000..520bd80
--- /dev/null
+++ b/backend/go/parakeet-cpp/diarize_stream.go
@@ -0,0 +1,87 @@
+package main
+
+import (
+	"fmt"
+	"sort"
+	"unsafe"
+)
+
+// Diarization of a long clip in pieces.
+//
+// parakeet_capi_diarize_pcm takes the whole clip in one call and builds its
+// log-mel features for all of it first, so peak memory grows with the length
+// of the recording (about 0.06 GB per minute of audio). The streaming
+// diarizer used here loads the same checkpoint but is a different code path
+// from diarize_pcm: it takes the audio in pieces, with the latency setting
+// passed explicitly, and keeps only a fixed-size speaker cache between them,
+// so a speaker keeps its number across pieces. Its segments are not
+// guaranteed to equal the whole-clip call's; checked on test recordings only.
+
+// Streaming diarization over PCM (parakeet_capi_diarize_stream_*), registered
+// in main.go. All nil on an older libparakeet.so.
+var (
+	CppDiarStreamBeginLatency func(ctx uintptr, latency int32) uintptr
+	CppDiarStreamFeed         func(s uintptr, pcm *float32, nSamples int32, isLast int32, out *uintptr, nOut *int32) int32
+	CppDiarStreamFree         func(s uintptr)
+	CppFreeDiarSegments       func(segs uintptr)
+)
+
+// cDiarSegment mirrors parakeet_diar_segment (parakeet_capi.h).
+type cDiarSegment struct {
+	Speaker int32
+	Start   float32
+	End     float32
+}
+
+// diarizeSegmentsStreamed feeds pcm to the streaming diarizer diarFeedSec
+// seconds at a time and returns the segments in start order.
+func (p *ParakeetCpp) diarizeSegmentsStreamed(pcm []float32) ([]diarizeSegmentJSON, error) {
+	p.engineMu.Lock()
+	defer p.engineMu.Unlock()
+	if p.diarCtx == 0 {
+		return nil, fmt.Errorf("parakeet-cpp: diarization model is not loaded")
+	}
+	stream := CppDiarStreamBeginLatency(p.diarCtx, diarLatencyModel) // latency passed explicitly; diarize_pcm may use another
+	if stream == 0 {
+		return nil, fmt.Errorf("parakeet-cpp: diarize stream begin failed: %s", CppLastError(p.diarCtx))
+	}
+	defer CppDiarStreamFree(stream)
+
+	var out []diarizeSegmentJSON
+	piece := p.diarFeedSec * asrSampleRate
+	for off := 0; off < len(pcm); off += piece {
+		end := min(off+piece, len(pcm))
+		last := int32(0)
+		if end == len(pcm) {
+			last = 1
+		}
+		var segs uintptr
+		var n int32
+		if rc := CppDiarStreamFeed(stream, &pcm[off], int32(end-off), last, &segs, &n); rc != 0 {
+			return nil, fmt.Errorf("parakeet-cpp: diarize stream feed failed: %s", CppLastError(p.diarCtx))
+		}
+		out = append(out, readDiarSegments(segs, int(n))...)
+	}
+	sort.SliceStable(out, func(i, j int) bool {
+		if out[i].Start != out[j].Start {
+			return out[i].Start < out[j].Start
+		}
+		return out[i].Speaker < out[j].Speaker
+	})
+	return out, nil
+}
+
+// readDiarSegments copies n segments out of a C-owned array and frees it.
+func readDiarSegments(segs uintptr, n int) []diarizeSegmentJSON {
+	if segs == 0 || n <= 0 {
+		return nil
+	}
+	p := unsafe.Pointer(segs) //nolint:govet // C-owned malloc'd buffer, not Go-GC memory (see goStringFromCPtr)
+	cs := unsafe.Slice((*cDiarSegment)(p), n)
+	res := make([]diarizeSegmentJSON, n)
+	for i, c := range cs {
+		res[i] = diarizeSegmentJSON{Speaker: int(c.Speaker), Start: float64(c.Start), End: float64(c.End)}
+	}
+	CppFreeDiarSegments(segs)
+	return res
+}
