diff --git a/backend/go/parakeet-cpp/wavread.go b/backend/go/parakeet-cpp/wavread.go
new file mode 100644
index 0000000..a1609bb
--- /dev/null
+++ b/backend/go/parakeet-cpp/wavread.go
@@ -0,0 +1,60 @@
+package main
+
+import (
+	"errors"
+	"io"
+	"math"
+
+	"github.com/go-audio/audio"
+	"github.com/go-audio/wav"
+)
+
+// readWavFloat32 decodes a PCM WAV into float32 samples, a block at a time,
+// into one slice sized from the file header. It returns the same values as
+// wav.Decoder.FullPCMBuffer followed by AsFloat32Buffer, but never holds the
+// clip as a slice of 64-bit integers that grows a few thousand samples at a
+// time. For an hour of 16 kHz audio that growth left about 3 GB of garbage
+// for the Go runtime to collect, which counted against the container's
+// memory cap.
+func readWavFloat32(r io.ReadSeeker) ([]float32, int, error) {
+	dec := wav.NewDecoder(r)
+	dec.ReadInfo()
+	if err := dec.Err(); err != nil {
+		return nil, 0, err
+	}
+	if dec.BitDepth == 0 {
+		return nil, 0, errors.New("parakeet-cpp: wav has no bit depth")
+	}
+	bytesPerSample := (int64(dec.BitDepth)-1)/8 + 1
+	// The header's data length is untrusted: cap the preallocation at the
+	// file's real size, so a forged header cannot ask for gigabytes.
+	claimed := dec.PCMLen()
+	if cur, err := r.Seek(0, io.SeekCurrent); err == nil {
+		if end, err := r.Seek(0, io.SeekEnd); err == nil {
+			if _, err := r.Seek(cur, io.SeekStart); err != nil {
+				return nil, 0, err
+			}
+			if claimed > end {
+				claimed = end
+			}
+		}
+	}
+	expected := int(claimed / bytesPerSample)
+	out := make([]float32, 0, expected)
+
+	factor := math.Pow(2, float64(dec.BitDepth)-1)
+	buf := &audio.IntBuffer{Data: make([]int, 1<<16)}
+	for {
+		n, err := dec.PCMBuffer(buf)
+		for _, v := range buf.Data[:n] {
+			out = append(out, float32(float64(v)/factor))
+		}
+		if err != nil && err != io.EOF {
+			return nil, 0, err
+		}
+		if n == 0 || err == io.EOF {
+			break
+		}
+	}
+	return out, int(dec.SampleRate), nil
+}
diff --git a/backend/go/parakeet-cpp/wavread_test.go b/backend/go/parakeet-cpp/wavread_test.go
new file mode 100644
index 0000000..97fb45b
--- /dev/null
+++ b/backend/go/parakeet-cpp/wavread_test.go
@@ -0,0 +1,82 @@
+package main
+
+import (
+	"bytes"
+	"math"
+	"os"
+	"testing"
+
+	"github.com/go-audio/audio"
+	"github.com/go-audio/wav"
+)
+
+// The block reader must return exactly what FullPCMBuffer + AsFloat32Buffer do.
+func TestReadWavFloat32MatchesFullPCMBuffer(t *testing.T) {
+	const n = 3*(1<<16) + 777 // not a multiple of the block size
+	data := make([]int, n)
+	for i := range data {
+		data[i] = int(20000 * math.Sin(float64(i)/37))
+	}
+	dir := t.TempDir()
+	path := dir + "/a.wav"
+	f, err := os.Create(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	enc := wav.NewEncoder(f, 16000, 16, 1, 1)
+	if err := enc.Write(&audio.IntBuffer{Data: data, Format: &audio.Format{NumChannels: 1, SampleRate: 16000}, SourceBitDepth: 16}); err != nil {
+		t.Fatal(err)
+	}
+	if err := enc.Close(); err != nil {
+		t.Fatal(err)
+	}
+	_ = f.Close()
+
+	raw, _ := os.ReadFile(path)
+	want, err := wav.NewDecoder(bytes.NewReader(raw)).FullPCMBuffer()
+	if err != nil {
+		t.Fatal(err)
+	}
+	wf := want.AsFloat32Buffer().Data
+	got, rate, err := readWavFloat32(bytes.NewReader(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rate != 16000 || len(got) != len(wf) || len(got) != n {
+		t.Fatalf("rate %d, got %d samples, want %d", rate, len(got), len(wf))
+	}
+	for i := range got {
+		if got[i] != wf[i] {
+			t.Fatalf("sample %d: got %v want %v", i, got[i], wf[i])
+		}
+	}
+}
+
+// A header that claims far more data than the file holds must not drive the
+// allocation, and the samples that are there must still decode.
+func TestReadWavFloat32ForgedLength(t *testing.T) {
+	le32 := func(v uint32) []byte { return []byte{byte(v), byte(v >> 8), byte(v >> 16), byte(v >> 24)} }
+	raw := []byte("RIFF")
+	raw = append(raw, le32(36+8)...)
+	raw = append(raw, "WAVEfmt "...)
+	raw = append(raw, le32(16)...)
+	raw = append(raw, 1, 0, 1, 0)     // PCM, mono
+	raw = append(raw, le32(16000)...) // sample rate
+	raw = append(raw, le32(32000)...) // byte rate
+	raw = append(raw, 2, 0, 16, 0)    // block align, bits
+	raw = append(raw, "data"...)
+	raw = append(raw, le32(8)...)
+	raw = append(raw, 0, 0, 0xE8, 0x03, 0x18, 0xFC, 0xFF, 0x7F) // 0, 1000, -1000, 32767
+	// Forge the data chunk size (bytes 40..43 in a 44-byte header) to 3 GB.
+	raw[40], raw[41], raw[42], raw[43] = 0x00, 0x00, 0x00, 0xC0
+	got, rate, err := readWavFloat32(bytes.NewReader(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if rate != 16000 || len(got) != 4 {
+		t.Fatalf("rate %d, %d samples", rate, len(got))
+	}
+	if cap(got) > 1<<20 {
+		t.Fatalf("capacity %d follows the forged header", cap(got))
+	}
+}
diff --git a/backend/go/parakeet-cpp/windowed.go b/backend/go/parakeet-cpp/windowed.go
new file mode 100644
index 0000000..9ee2fb1
--- /dev/null
+++ b/backend/go/parakeet-cpp/windowed.go
@@ -0,0 +1,148 @@
+package main
+
+// Windowed speech-to-text for long recordings.
+//
+// parakeet.cpp encodes a whole clip in one graph, so peak memory grows with
+// the length of the recording (about 0.33 GB per minute of audio above roughly
+// 11 minutes, and with the square of the length below that). When the model
+// option asr_window_seconds is set and a clip is longer than one window, the
+// clip is transcribed in overlapping windows and the words are joined again
+// at a quiet gap inside each overlap. Memory then follows the window, not the
+// recording. Speaker labels are not affected: diarization still runs over the
+// whole clip (speakers.go), so a speaker keeps one label for the whole clip.
+
+const asrSampleRate = 16000
+
+// Words this close to a window edge are not trusted (the encoder has less
+// context there), so a cut is only placed at least this far inside the overlap.
+const asrCutMarginSec = 4.0
+
+// A pause at least this long is a good place to cut; shorter gaps still win
+// when nothing longer is inside the overlap.
+const asrMinGapSec = 0.05
+
+// asrWindowSpan is a half-open range of samples [start, end).
+type asrWindowSpan struct{ start, end int }
+
+// asrWindows lays overlapping windows over n samples. A clip that fits in one
+// window (or windowing off, win <= 0) gets a single span. The last window is
+// stretched back so it is never shorter than overlap, which would leave no
+// room for a cut.
+func asrWindows(n, win, overlap int) []asrWindowSpan {
+	if win <= 0 || n <= win {
+		return []asrWindowSpan{{0, n}}
+	}
+	if overlap < 0 {
+		overlap = 0
+	}
+	if overlap > win/2 {
+		overlap = win / 2
+	}
+	step := win - overlap
+	var out []asrWindowSpan
+	for s := 0; ; s += step {
+		e := s + win
+		if e >= n {
+			out = append(out, asrWindowSpan{s, n})
+			break
+		}
+		out = append(out, asrWindowSpan{s, e})
+	}
+	// A tail shorter than two overlaps adds nothing the last full window
+	// cannot cover, so that window is stretched to the end instead.
+	if len(out) >= 2 && out[len(out)-1].end-out[len(out)-1].start < 2*overlap {
+		out = out[:len(out)-1]
+		out[len(out)-1].end = n
+	}
+	return out
+}
+
+// mergeWindowDocs joins per-window transcripts into one. docs[i] holds the
+// words of window i with times relative to that window; startSec[i] and
+// endSec[i] are where the window begins and ends in the whole clip.
+func mergeWindowDocs(docs []transcriptJSON, startSec, endSec []float64) transcriptJSON {
+	if len(docs) == 1 {
+		return docs[0]
+	}
+	merged := transcriptJSON{FrameSec: docs[0].FrameSec}
+	words := make([][]transcriptWord, len(docs))
+	for i, d := range docs {
+		for _, w := range d.Words {
+			w.Start += startSec[i]
+			w.End += startSec[i]
+			words[i] = append(words[i], w)
+		}
+	}
+	// cuts[i] separates window i from window i+1, inside their overlap.
+	cuts := make([]float64, len(docs)-1)
+	for i := range cuts {
+		cuts[i] = chooseCut(words[i], startSec[i+1], endSec[i])
+	}
+	for i := range docs {
+		from, to := negInf, posInf
+		if i > 0 {
+			from = cuts[i-1]
+		}
+		if i < len(cuts) {
+			to = cuts[i]
+		}
+		for _, w := range words[i] {
+			if mid := (w.Start + w.End) / 2; mid >= from && mid < to {
+				merged.Words = append(merged.Words, w)
+			}
+		}
+		for _, t := range docs[i].Tokens {
+			abs := t.T + startSec[i]
+			if abs >= from && abs < to {
+				t.T = abs
+				merged.Tokens = append(merged.Tokens, t)
+			}
+		}
+	}
+	parts := make([]string, len(merged.Words))
+	for i, w := range merged.Words {
+		parts[i] = w.W
+	}
+	merged.Text = joinWords(parts)
+	return merged
+}
+
+const (
+	posInf = 1e18
+	negInf = -1e18
+)
+
+// chooseCut picks the cut time inside the overlap [from, to]: the middle of
+// the longest pause between two words of the earlier window, keeping
+// asrCutMarginSec away from both edges. With no pause there, or no room for
+// the margins, it is the middle of the overlap.
+func chooseCut(ws []transcriptWord, from, to float64) float64 {
+	lo, hi := from+asrCutMarginSec, to-asrCutMarginSec
+	if hi <= lo {
+		return (from + to) / 2
+	}
+	best, bestLen := (lo+hi)/2, 0.0
+	for i := 1; i < len(ws); i++ {
+		g := ws[i].Start - ws[i-1].End
+		mid := (ws[i].Start + ws[i-1].End) / 2
+		if g >= asrMinGapSec && g > bestLen && mid >= lo && mid <= hi {
+			best, bestLen = mid, g
+		}
+	}
+	return best
+}
+
+func joinWords(parts []string) string {
+	n := 0
+	for _, p := range parts {
+		n += len(p) + 1
+	}
+	b := make([]byte, 0, n)
+	for i, p := range parts {
+		if i > 0 {
+			b = append(b, ' ')
+		}
+		b = append(b, p...)
+	}
+	return string(b)
+}
